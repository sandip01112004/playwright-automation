{
  "name": "supplierfirst_automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start:api": "ts-node trigger-api.ts",
    "copy-env": "node -e \"const fs=require('fs'); if(fs.existsSync('.env')) fs.copyFileSync('.env', 'supplierfirst-automation-dashboard/.env');\"",
    "build:ui": "npm run copy-env && cd supplierfirst-automation-dashboard && npm run build",
    "start:prod": "node -e \"process.env.NODE_ENV='production'; require('ts-node/register'); require('./trigger-api.ts');\"",
    "start:all": "concurrently \"npm run start:api\" \"npm run copy-env && cd supplierfirst-automation-dashboard && npm start\"",
    "start:unified": "npm run build:ui && npm run start:api"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/readline-sync": "^1.4.8",
    "dotenv": "^17.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "readline-sync": "^1.4.10"
  }
}